{
  "name": "Forja — estudio de archivos",
  "short_name": "Forja",
  "description": "Convierte y edita imagen, audio y vídeo sin subir nada a ningún servidor. Todo ocurre en tu dispositivo.",
  "lang": "es",
  "dir": "ltr",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0c0f",
  "theme_color": "#0a0c0f",
  "categories": ["photo", "video", "music", "utilities", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "file_handlers": [
    {
      "action": ".",
      "name": "Archivo de imagen, audio o vídeo",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".avif"],
        "audio/*": [".mp3", ".wav", ".ogg", ".flac", ".m4a", ".aac", ".opus"],
        "video/*": [".mp4", ".webm", ".mkv", ".mov", ".avi"]
      }
    }
  ]
}
